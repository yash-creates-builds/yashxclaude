{
  "name": "seeti",
  "private": true,
  "version": "1.0.0",
  "description": "Seeti \u2014 counts pressure cooker whistles so you don't have to.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "app:sync": "vite build && cap sync",
    "app:android": "vite build && cap sync android && cap open android",
    "app:ios": "vite build && cap sync ios && cap open ios",
    "app:assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#FFF8EF' --splashBackgroundColor '#FFF8EF'",
    "app:icons": "node scripts/make-app-assets.cjs && npm run app:assets"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tensorflow/tfjs": "^4.22.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6"
  }
}