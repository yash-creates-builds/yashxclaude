rules_version = '2';
// Dhobi Diary — only members of a household can see or change its diary.
// Joining needs the household's 6-character code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function household(hid) { return /databases/$(database)/documents/households/$(hid); }
    function isMember(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // code → household id. Readable one at a time (no listing), so codes can't be browsed.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hid'])
        && getAfter(household(request.resource.data.hid)).data.createdBy == request.auth.uid
        && getAfter(household(request.resource.data.hid)).data.code == code;
    }

    match /households/{hid} {
      allow get: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.size() == 6;

      match /members/{uid} {
        allow read: if isMember(hid);
        // You can only add yourself, and only with the right code.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.code == getAfter(household(hid)).data.code
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.code == resource.data.code;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /batches/{id} { allow read, write: if isMember(hid); }
      match /visits/{id} { allow read, write: if isMember(hid); }
      match /shared/{key} {
        allow read, write: if isMember(hid) && key in ['rates', 'paid', 'customItems', 'dhobis'];
      }
    }
  }
}
